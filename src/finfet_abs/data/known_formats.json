{
  "version": 1,
  "notes": "Azure のサービスがストレージアカウントに出力するログ・データのパス構造（7.2）。{名前} は入力した値（空の場合は文字列の変数）、{{…}} は変数です。パスパターンのひな形は正規表現です。",
  "formats": [
    {
      "id": "resource-logs",
      "group": "Azure Monitor",
      "name": "リソースログ（診断設定）",
      "description": "診断設定でストレージアカウントに送信したリソースログ。1 時間ごとの PT1H.json です。",
      "container_regex": "^insights-logs-[a-z0-9]+$",
      "container_template": "insights-logs-{category}",
      "path_template": "resourceId=/(?i:subscriptions/{sub}/resourceGroups/{rg}/providers/{rtype}/)y={{dt=YYYY}}/m={{dt=MM}}/d={{dt=DD}}/h={{dt=hh}}/m=00/PT1H\\.json",
      "inputs": [
        {"name": "category", "label": "ログのカテゴリ", "check": "^[A-Za-z0-9]+$", "lower": true, "required": true,
         "suggest": ["StorageRead", "StorageWrite", "StorageDelete", "AuditEvent", "AzureFirewallApplicationRule", "AzureFirewallNetworkRule", "AppServiceHTTPLogs", "ApplicationGatewayAccessLog"]},
        {"name": "sub", "label": "サブスクリプション ID", "check": "^[0-9A-Fa-f-]{36}$"},
        {"name": "rg", "label": "リソースグループ", "check": "^[-\\w._()]{1,90}$"},
        {"name": "rtype", "label": "リソースの種類", "kind": "select", "default": "storage-blob", "options": [
          {"id": "storage-blob", "label": "Microsoft.Storage/storageAccounts（Blob）", "value": "Microsoft\\.Storage/storageAccounts/{resource}/blobServices/default"},
          {"id": "storage-file", "label": "Microsoft.Storage/storageAccounts（File）", "value": "Microsoft\\.Storage/storageAccounts/{resource}/fileServices/default"},
          {"id": "storage-queue", "label": "Microsoft.Storage/storageAccounts（Queue）", "value": "Microsoft\\.Storage/storageAccounts/{resource}/queueServices/default"},
          {"id": "storage-table", "label": "Microsoft.Storage/storageAccounts（Table）", "value": "Microsoft\\.Storage/storageAccounts/{resource}/tableServices/default"},
          {"id": "keyvault", "label": "Microsoft.KeyVault/vaults", "value": "Microsoft\\.KeyVault/vaults/{resource}"},
          {"id": "firewall", "label": "Microsoft.Network/azureFirewalls", "value": "Microsoft\\.Network/azureFirewalls/{resource}"},
          {"id": "appgw", "label": "Microsoft.Network/applicationGateways", "value": "Microsoft\\.Network/applicationGateways/{resource}"},
          {"id": "web", "label": "Microsoft.Web/sites", "value": "Microsoft\\.Web/sites/{resource}"},
          {"id": "other", "label": "そのほか", "value": "[^/]+/[^/]+/{resource}(?:/[^/]+/[^/]+)*"}
        ]},
        {"name": "resource", "label": "リソース名", "check": "^[-\\w.]{1,80}$"}
      ],
      "path_timezone": "utc",
      "notes": ["リソース ID の部分は、大文字・小文字を区別せずに照合します（Azure が出力する表記は、リソースの種類や作成された時期によって、すべて大文字の場合と大文字・小文字が混在する場合があります）。検索時に実際の表記を確認して取得します。", "現在の時間の Blob は書き込み中です。"],
      "verified": true,
      "verified_note": "構造は確認済みです。リソースの種類ごとの下位の階層は未確認です。",
      "examples": [
        {"inputs": {"category": "StorageRead", "sub": "00000000-0000-0000-0000-000000000000", "rg": "rg-example", "rtype": "storage-blob", "resource": "stexample01"},
         "container": "insights-logs-storageread",
         "blob": "resourceId=/SUBSCRIPTIONS/00000000-0000-0000-0000-000000000000/RESOURCEGROUPS/RG-EXAMPLE/PROVIDERS/MICROSOFT.STORAGE/STORAGEACCOUNTS/STEXAMPLE01/BLOBSERVICES/DEFAULT/y=2026/m=11/d=20/h=09/m=00/PT1H.json"},
        {"inputs": {"category": "AuditEvent", "rtype": "keyvault"},
         "container": "insights-logs-auditevent",
         "blob": "resourceId=/SUBSCRIPTIONS/00000000-0000-0000-0000-000000000000/RESOURCEGROUPS/RG-EXAMPLE/PROVIDERS/MICROSOFT.KEYVAULT/VAULTS/KV-EXAMPLE/y=2026/m=11/d=20/h=09/m=00/PT1H.json"},
        {"inputs": {"category": "AzureFirewallNetworkRule", "rtype": "other"},
         "container": "insights-logs-azurefirewallnetworkrule",
         "blob": "resourceId=/SUBSCRIPTIONS/00000000-0000-0000-0000-000000000000/RESOURCEGROUPS/RG-EXAMPLE/PROVIDERS/MICROSOFT.NETWORK/AZUREFIREWALLS/FW-EXAMPLE/y=2026/m=01/d=02/h=23/m=00/PT1H.json"}
      ]
    },
    {
      "id": "activity-logs",
      "group": "Azure Monitor",
      "name": "アクティビティログ",
      "description": "診断設定でストレージアカウントに送信したアクティビティログ。",
      "container_regex": "^insights-activity-logs$",
      "container_template": "insights-activity-logs",
      "path_template": "resourceId=/(?i:subscriptions/{sub}/)y={{dt=YYYY}}/m={{dt=MM}}/d={{dt=DD}}/h={{dt=hh}}/m=00/PT1H\\.json",
      "inputs": [
        {"name": "sub", "label": "サブスクリプション ID", "check": "^[0-9A-Fa-f-]{36}$"}
      ],
      "path_timezone": "utc",
      "notes": ["リソース ID の部分は、大文字・小文字を区別せずに照合します（Azure が出力する表記は、リソースの種類や作成された時期によって、すべて大文字の場合と大文字・小文字が混在する場合があります）。検索時に実際の表記を確認して取得します。", "現在の時間の Blob は書き込み中です。"],
      "verified": false,
      "examples": [
        {"inputs": {}, "container": "insights-activity-logs",
         "blob": "resourceId=/SUBSCRIPTIONS/00000000-0000-0000-0000-000000000000/y=2026/m=11/d=20/h=09/m=00/PT1H.json"}
      ]
    },
    {
      "id": "metrics",
      "group": "Azure Monitor",
      "name": "メトリック（診断設定）",
      "description": "診断設定でストレージアカウントに送信したメトリック。",
      "container_regex": "^insights-metrics-[a-z0-9]+$",
      "container_template": "insights-metrics-pt1m",
      "path_template": "resourceId=/(?i:subscriptions/{sub}/resourceGroups/{rg}/providers/[^/]+/[^/]+/{resource}(?:/[^/]+/[^/]+)*/)y={{dt=YYYY}}/m={{dt=MM}}/d={{dt=DD}}/h={{dt=hh}}/m=00/PT1H\\.json",
      "inputs": [
        {"name": "sub", "label": "サブスクリプション ID", "check": "^[0-9A-Fa-f-]{36}$"},
        {"name": "rg", "label": "リソースグループ", "check": "^[-\\w._()]{1,90}$"},
        {"name": "resource", "label": "リソース名", "check": "^[-\\w.]{1,80}$"}
      ],
      "path_timezone": "utc",
      "notes": ["リソース ID の部分は、大文字・小文字を区別せずに照合します（Azure が出力する表記は、リソースの種類や作成された時期によって、すべて大文字の場合と大文字・小文字が混在する場合があります）。検索時に実際の表記を確認して取得します。", "現在の時間の Blob は書き込み中です。"],
      "verified": false,
      "examples": [
        {"inputs": {"resource": "kv-example"}, "container": "insights-metrics-pt1m",
         "blob": "resourceId=/SUBSCRIPTIONS/00000000-0000-0000-0000-000000000000/RESOURCEGROUPS/RG-EXAMPLE/PROVIDERS/MICROSOFT.KEYVAULT/VAULTS/KV-EXAMPLE/y=2026/m=11/d=20/h=09/m=00/PT1H.json"}
      ]
    },
    {
      "id": "log-analytics-export",
      "group": "Azure Monitor",
      "name": "Log Analytics のエクスポート",
      "description": "Log Analytics ワークスペースのデータのエクスポート。5 分ごとのフォルダーに PT05M.json が作成されます。",
      "container_regex": "^am-[a-z0-9]+$",
      "container_template": "am-{table}",
      "path_template": "WorkspaceResourceId=/(?i:subscriptions/{sub}/resourcegroups/{rg}/providers/microsoft\\.operationalinsights/workspaces/{ws}/)y={{dt=YYYY}}/m={{dt=MM}}/d={{dt=DD}}/h={{dt=hh}}/m={{dt=mm}}/PT05M(?:_\\d+)?\\.json",
      "inputs": [
        {"name": "table", "label": "テーブル名", "check": "^[A-Za-z0-9_]+$", "lower": true, "required": true, "suggest": ["SecurityEvent", "Syslog", "AzureActivity", "AzureDiagnostics"]},
        {"name": "sub", "label": "サブスクリプション ID", "check": "^[0-9A-Fa-f-]{36}$"},
        {"name": "rg", "label": "リソースグループ", "check": "^[-\\w._()]{1,90}$"},
        {"name": "ws", "label": "ワークスペース名", "check": "^[-\\w]{1,63}$"}
      ],
      "path_timezone": "utc",
      "notes": ["リソース ID の部分は、大文字・小文字を区別せずに照合します（Azure が出力する表記は、リソースの種類や作成された時期によって、すべて大文字の場合と大文字・小文字が混在する場合があります）。検索時に実際の表記を確認して取得します。", "現在の時間の Blob は書き込み中です。"],
      "verified": true,
      "verified_note": "構造は確認済みです。リソース ID の部分の大文字・小文字は未確認です。",
      "examples": [
        {"inputs": {"table": "SecurityEvent", "ws": "law-example"}, "container": "am-securityevent",
         "blob": "WorkspaceResourceId=/subscriptions/00000000-0000-0000-0000-000000000000/resourcegroups/rg-example/providers/microsoft.operationalinsights/workspaces/law-example/y=2026/m=11/d=20/h=09/m=05/PT05M_1.json"}
      ]
    },
    {
      "id": "entra-logs",
      "group": "Microsoft Entra ID",
      "name": "サインインログ・監査ログ",
      "description": "Microsoft Entra ID の診断設定でストレージアカウントに送信したログ。",
      "container_regex": "^insights-logs-(?:auditlogs|signinlogs|noninteractiveusersigninlogs|serviceprincipalsigninlogs|managedidentitysigninlogs|provisioninglogs|adfssigninlogs|riskyusers|userriskevents|microsoftgraphactivitylogs)$",
      "container_template": "insights-logs-{category}",
      "path_template": "tenantId={tenant}/y={{dt=YYYY}}/m={{dt=MM}}/d={{dt=DD}}/h={{dt=hh}}/m=00/PT1H\\.json",
      "inputs": [
        {"name": "category", "label": "ログのカテゴリ", "check": "^[A-Za-z]+$", "lower": true, "required": true,
         "suggest": ["AuditLogs", "SignInLogs", "NonInteractiveUserSignInLogs", "ServicePrincipalSignInLogs", "ManagedIdentitySignInLogs", "ProvisioningLogs", "ADFSSignInLogs", "RiskyUsers", "UserRiskEvents", "MicrosoftGraphActivityLogs"]},
        {"name": "tenant", "label": "テナント ID", "check": "^[0-9A-Fa-f-]{36}$"}
      ],
      "path_timezone": "utc",
      "notes": ["パスの形式は未確認です。Blob が見つからない場合は、パスパターンを修正してください。"],
      "verified": false,
      "examples": [
        {"inputs": {"category": "SignInLogs"}, "container": "insights-logs-signinlogs",
         "blob": "tenantId=00000000-0000-0000-0000-000000000000/y=2026/m=11/d=20/h=09/m=00/PT1H.json"}
      ]
    },
    {
      "id": "vnet-flow-logs",
      "group": "ネットワーク",
      "name": "仮想ネットワークのフローログ",
      "description": "Network Watcher の仮想ネットワークのフローログ。",
      "container_regex": "^insights-logs-flowlogflowevent$",
      "container_template": "insights-logs-flowlogflowevent",
      "path_template": "flowLogResourceID=/(?i:{sub}_NETWORKWATCHERRG/NETWORKWATCHER_{region}_{flowlog}/)y={{dt=YYYY}}/m={{dt=MM}}/d={{dt=DD}}/h={{dt=hh}}/m=00/macAddress={{mac}}/PT1H\\.json",
      "inputs": [
