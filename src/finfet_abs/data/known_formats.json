    {
      "id": "storage-analytics",
      "group": "Storage",
      "name": "Storage Analytics（$logs）",
      "description": "クラシックの Storage Analytics のログ。",
      "container_regex": "^\\$logs$",
      "container_template": "$logs",
      "path_template": "{service}/{{dt=YYYY}}/{{dt=MM}}/{{dt=DD}}/{{dt=hh}}00/\\d{6}\\.log",
      "inputs": [
        {"name": "service", "label": "サービス", "kind": "select", "default": "", "var": "service", "options": [
          {"id": "", "label": "すべて", "value": ""},
          {"id": "blob", "label": "blob", "value": "blob"},
          {"id": "table", "label": "table", "value": "table"},
          {"id": "queue", "label": "queue", "value": "queue"}
        ]}
      ],
      "path_timezone": "utc",
      "notes": ["$logs はコンテナーの一覧に表示されません。", "ログの時刻は、その時間帯に完了した要求の時刻です。書き込まれるまでに最大で 1 時間程度の遅れがあります。"],
      "verified": true,
      "examples": [
        {"inputs": {}, "container": "$logs", "blob": "blob/2026/11/20/0900/000001.log"},
        {"inputs": {"service": "queue"}, "container": "$logs", "blob": "queue/2026/11/20/2300/000012.log"}
      ]
    },
